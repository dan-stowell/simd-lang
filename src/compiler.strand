# The Strand compiler, in Strand.
#
# No loops, no branches: every line below is one fused AVX-512 loop. A line may define several
# vectors (':x' stores and keeps going, '%x' compress-stores), so a phase is a handful of loops:
#   text -> byte classes -> tokens -> names (scatter race) -> classes -> depth (= registers)
#        -> three code streams laid out by prefix sums -> gather stencil bytes, scatter operands -> ELF
# The generated tables (src/tables.strand) are prepended to this file.
# Specification: boot/spec.py and boot/strand.py. Error numbers: boot/spec.py.

# ---------------------------------------------------------------- text = prelude ++ source ++ "\n"
&prelude >P
input 0 * 1 + $N
P N + 1 + >T
T 1 - >Tm
0 1 - >Neg
0 8 - >Neg8
~T 0 * 10 + >text
prelude idx !text
input idx P + !text

# ---------------------------------------------------------------- byte classes: comments, strings, token chars
# cm: inside a comment = more '#' so far than at the last newline (two scans). Same trick for quote parity.
text 35 = scan dup text 10 = * scanmax > 1 ^ :ncm text 34 = & :q dup scan dup text 10 = %qnl dup text 10 = * scanmax - 1 & :par | text 32 > | ncm & :tc end
# token starts/ends -> compressed token arrays; per-byte token number; line number of each token.
# E_QUOTE (opening quote not starting a token, closing quote not ending one) rides along as the sum.
q par 1 ^ & prev tc & tc dup prev over over 1 ^ & :ts idx over %start text 10 = scan over %ln0 scan 1 - :bt drop swap 1 ^ & idx over %tend drop q par & ts 1 ^ & | $Eq2
# ... and odd quotes on a line
qnl dup prev - 1 & $Eq1
Eq1 Eq2 + 0 > halt
&qnl >NL
NL 2 + >NL2

# ---------------------------------------------------------------- tokens: sigil, operand class, name span
&start >NT
NT 1 - >NTm
start @text 127 min :c0 @opctab :o0 end
tend start - :len 1 > c0 @sigtab :s0 0 > & start 1 + @text 127 min @opctab :o1 dup 0 > swap 4 < & & :sig s0 * :sgi sig o1 o0 sel :opc dup 3 = :lit swap 4 = :str | 1 ^ :isname drop start sig + :ns drop len sig - :nlen drop ln0 1 + :ln1 dup prev != :first drop end
~NT 1 + NTm min @first idx NTm = | >last
ns 2 * lit + >nsl

# ---------------------------------------------------------------- one pass over the bytes, seen from their tokens:
# literal digits (E_LEX), decimal weights, two name-hash sums, constant-pool units. Running sums are
# never stored: their values at each token's first and last byte are compressed straight out.
bt @nsl dup 1 & tc & :blit drop 1 >> :bns idx swap - :off 0 >= tc & :bop blit & :lb text 48 >= text 57 <= & 1 ^ & off 0 = tc & :nsm drop bt @tend :bend idx 1 + = tc & :lastb blit & :u1 drop lb text 48 - * bend 1 - idx - 0 max 8 min @pow10 * dup scan dup lastb %dpe swap - nsm %dps off 0 max 63 min 256 * text + :hx Ha1 * dup Hs1 >> ^ Hb1 * bop * :hv1 scan dup lastb %h1e hv1 - nsm %h1s idx hx Ha2 * dup Hs2 >> ^ Hb2 * bop * dup scan dup lastb %h2e swap - nsm %h2s drop idx idx u1 par q 1 ^ & | dup scan swap - nsm %pidx drop drop $El1
lit nlen Maxdig > & $El2
El1 El2 + 0 > 2 * halt
isname nlen Maxname > & $En
En 0 > 3 * halt
# a segmented sum is a difference of two scan values; the loop above compressed both ends per token
dpe dps - lit * :val h1e h1s - :h1 drop h2e h2s - :h2 drop end
bt @val u1 * par q 1 ^ & :u2 text * + u1 u2 | ?pool
&pool >U

# ---------------------------------------------------------------- names: the scatter race
# Every unresolved name token scatters its index into table[key]; the last writer owns the slot.
# A token whose slot owner has its fingerprint is resolved to that owner (its canonical occurrence,
# which is therefore the name's LAST occurrence). Losers race again under the next key.
NT dup 1 >> | dup 2 >> | dup 4 >> | dup 8 >> | dup 16 >> | 2 * 1 + >Mask
Mask 1 + >Tabm
~Tabm 0 * >tab
isname >act
~NT 0 * >rep
act h1 Ru0 * h2 Rv0 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok0 swap rep sel >rep
act ok0 1 ^ & >act
act h1 Ru1 * h2 Rv1 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok1 swap rep sel >rep
act ok1 1 ^ & >act
act h1 Ru2 * h2 Rv2 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok2 swap rep sel >rep
act ok2 1 ^ & >act
act h1 Ru3 * h2 Rv3 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok3 swap rep sel >rep
act ok3 1 ^ & $Er
Er 0 > 4 * halt
# exact check: every name byte equals the corresponding byte of its canonical occurrence
rep @ns ns - isname * >vd
bt @vd idx + 0 max Tm min @text text != bop * $Ec1
rep @nlen nlen != isname * $Ec2
Ec1 Ec2 + 0 > 5 * halt

# ---------------------------------------------------------------- keywords by self-join; slots by one scan
# prelude token k is keyword k: mark each one's canonical occurrence
~NT 0 * >kwof
~NT 1 + idx Kn < rep Neg sel !kwof
rep @kwof isname * :kw 0 = isname & rep idx = & :isrep scan >sid
rep @sid isname * kw 0 = * >slot
isrep $S
S 1 + >S1

# ---------------------------------------------------------------- token classes
kw 0 > sgi 0 > & Cerr kw 0 > sgi 0 = & kw 1 - sgi 5 * opc + @clstab sel sel dup @leadof over - first * + dup Cnone swap - idx Kn < * + :cls4 Cerr = $Et
Et 0 > 6 * halt
# data lines: the class of a line's last token decides
~NL2 0 * >lsk
cls4 last ln1 Neg sel !lsk
ln1 @lsk Cdata = last 1 ^ & :ditem sgi 0 = lit & cls4 Cstr = | 1 ^ & cls4 Cdata = last 1 ^ & cls4 Cstr = | ditem 1 ^ & | $Ed
Ed 0 > 7 * halt
ditem Cnone cls4 sel >clso
# chunk-local vectors: a ':x' whose last occurrence (its canonical token) is on the tee's own line never
# needs an array. Its occurrences there switch class, and keep just the current chunk in x's slot.
~S1 0 * >tdef
~NT 1 + clso Ctee = clso Cteec = | slot Neg sel !tdef
slot @tdef :td1 1 - 0 max :td @clso Ctee = td1 0 > & isname & td @rep @ln1 td @ln1 = & ln1 td @ln1 = & :loc clso @localof clso - * clso + >cls

# ---------------------------------------------------------------- stack depth = register allocation, by one scan
cls @delta 2 - :dlt scan :da dlt - :d0 0 < d0 8 > | da 0 = last != | cls Ncode < :code & $Edp
Edp 0 > 8 * halt
cls Nd * d0 + code * :tid @slen :sl 0 = code & $Es
Es 0 > 9 * halt
# two carry-using ops at one depth on one line would share a carry register: detect by scatter race
cls @carry code * >cg
NL2 32 * >Ct
~Ct 0 * >ctab
cg 0 > ln1 32 * cg 16 * + d0 + Neg sel >ck
~NT ck !ctab
ck 0 max @ctab idx != cg 0 > & $Ecy
Ecy 0 > 10 * halt
# a line may not read the vector it scatters into
~NL2 0 * >lss
last cls Cscatter = & slot * last ln1 Neg sel !lss
ln1 @lss dup 0 > swap slot = & cls @readsvec & $Ea
Ea 0 > 11 * halt
# every used variable is defined somewhere
~S1 0 * >def
cls @defines dup slot Neg sel !def
slot @def 0 = cls @uses & isname & $Eu
Eu 0 > 12 * halt
# tee rules: a tee-defined name has exactly one definition, and on the tee's own line it may only be
# re-read after a ':' tee
~S1 0 * >ldef
~NT cls @defines slot Neg sel !ldef
td1 0 > cls @defines & slot @ldef idx != & $Et1
td @clso Ctee = clso Cvec = clso Clen = | & idx td > & 1 ^ td1 0 > isname & idx td != & ln1 td @ln1 = & & $Et2
Et1 Et2 + 0 > 13 * halt

# ---------------------------------------------------------------- data image: slots, then pool
lit S1 Slot * pidx 4 * + slot Slot * sel >disp
S1 Slot * U 4 * + >Ds
Vbase 112 + Stublen + >Vd
S1 16 * >Si
~Si 0 * >simg
~NL2 0 * >lfp
pidx first ln1 Neg sel !lfp
ln1 @lfp :fp 4 * Vd + S1 Slot * + cls Cdata = :isd slot 16 * Neg8 sel !simg
pidx fp - isd slot 16 * 2 + Neg8 sel !simg
~1 Ds + 0 !simg

# ---------------------------------------------------------------- code layout
# Liveness without analysis: the program is a straight line, so a vector is dead after the line holding
# its last occurrence -- and the scatter race already made that occurrence the canonical one (rep = self).
isname opc 1 = & slot 0 > & rep idx = & idx Kn >= & loc 1 ^ & >dying
# Each token owns up to three pieces of code, and a line is laid out as
#   [every token's prologue] [every token's body] [releases of vectors that die here]
# so loop-invariant work is hoisted with no motion pass: three streams, three prefix sums.
code tid @qlen * :psz scan :sp psz - :spx code sl * :asz scan :sa asz - :sax dying Rell * :bsz scan bsz - :sbx drop drop end
~NL2 0 * >lft
~NT first ln1 Neg sel !lft
~NL2 0 * >llt
~NT last ln1 Neg sel !llt
ln1 @lft :tf @sbx :fb tf @sax + spx + :offp ln1 @llt :tl @sp :lp fb + sax + :offa lp tl @sa + sbx + :offb drop drop end
NTm @sp NTm @sa + NTm @sbx + NTm @bsz + >C

# ---------------------------------------------------------------- code bytes: gather stencils, scatter operands
# every piece scatters its offset to its first byte; a running max fills forward (offsets are monotone),
# so each code byte finds its piece and gathers its stencil byte
~C 0 * :mark :dmark end
offp psz 0 > offp Neg sel !mark
tid @qstart offp - psz 0 > offp Neg sel !dmark
offa code offa Neg sel !mark
tid @sstart offa - code offa Neg sel !dmark
offb dying offb Neg sel !mark
offb Rels swap - dying offb Neg sel !dmark
mark scanmax @dmark idx + @sten >cb
# operands: four byte scatters per stream (a negative index is a masked-off lane)
tid @qpos dup 0 > psz 0 > & swap offp + 1 - Neg8 sel >pp
tid @qadd disp + >pv
pv 255 & pp !cb
pv 8 >> 255 & pp 1 + !cb
pv 16 >> 255 & pp 2 + !cb
pv 24 >> 255 & pp 3 + !cb
tid @ppos dup 0 > code & swap offa + 1 - Neg8 sel >pp
tid @padd disp + >pv
pv 255 & pp !cb
pv 8 >> 255 & pp 1 + !cb
pv 16 >> 255 & pp 2 + !cb
pv 24 >> 255 & pp 3 + !cb
dying offb Relp + 1 - Neg8 sel >pp
slot Slot * >pv
pv 255 & pp !cb
pv 8 >> 255 & pp 1 + !cb
pv 16 >> 255 & pp 2 + !cb
pv 24 >> 255 & pp 3 + !cb

# ---------------------------------------------------------------- ELF, by concatenation
112 Stublen + Ds + C + &tail + >F
~8 8 * dup 0 * F + swap >> 255 & >f8
ehdr out
f8 out
f8 out
stub out
simg out4
pool out4
cb out
tail out
