# The Strand compiler, in Strand.
#
# No loops, no branches: every line below is one fused AVX-512 loop. A line may define several
# vectors (':x' stores and keeps going, '%x' compress-stores), so a phase is a handful of loops:
#   bytes -> automaton -> token positions -> four dwords per token -> names (scatter race) -> classes -> depth (= registers)
#        -> three code streams laid out by prefix sums -> copy stencil slices, store operands -> ELF
# The generated tables (src/tables.strand) are prepended to this file.
# Specification: boot/spec.py and boot/strand.py. Error numbers: boot/spec.py.
# ---------------------------------------------------------------- lexing, on byte lanes
# One 3-state automaton says what every byte is: 0 code, 1 comment, 2 inside a string. From its state:
# token characters, where tokens start and end, and every E_QUOTE rule. The positions leave the byte
# line as dword vectors ('%'); nothing else about a byte is kept but the byte itself (':text').
#   tc   token character: inside a string, or code and not blank
#   ev   positions of token starts and of newlines, in order;  te0  positions just past a token
#   E_QUOTE: a string still open at a newline or at '#'; an opening quote not at a token start;
#            a closing quote followed by a token character
0 1 - >Neg
0 8 - >Neg8
bytes :text :c @lcls /ldfa :s s 2 = c 32 > s 0 = & | :tc dup prev :ptc 1 ^ & c 10 = | %ev ptc tc 1 ^ & %te0 dup prev 2 = c 10 = c 35 = | & c 34 = :isq s 2 = & ptc & | 0 isq s 0 = & prev c 32 > & s 1 != & | | swap drop $Eq2
# ... and a string still open at the end of the text: every earlier line has an even number of quotes
bytes :cq @lcls /ldfa 1 != cq 34 = & $Qn
Eq2 Qn 1 & + 0 > halt
&text >N
N 1 - >Tm
# events -> tokens: a running count of newline events is each token's line number
ev dup dup [text 10 = :isnl scan isnl 1 ^ :ist %ln0 ist %start end
&start >NT
NT 1 - >NTm
&ev NT - 1 + >NL
NL 2 + >NL2
~NT 0 * N + >tend
te0 idx !tend

# ---------------------------------------------------------------- tokens: sigil, operand class, name span
start [text 127 min :c0 @opctab :o0 end
tend start - :len 1 > c0 @sigtab :s0 0 > & start 1 + Tm min [text 127 min @opctab :o1 dup 0 > swap 4 < & & :sig s0 * :sgi sig o1 o0 sel :opc dup 3 = :lit swap 4 = :str | 1 ^ :isname drop start sig + :ns drop len sig - :nlen drop ln0 1 + :ln1 dup prev != :first drop end
~NT 1 + NTm min @first idx NTm = | >last

# ---------------------------------------------------------------- a token's name is four dwords
# Names have at most 16 bytes and literals 9 digits, so everything about a token's text is in four
# gathers from its first byte: mj masks the bytes of dword j that belong to the name.
ns Tm min {text Neg 4 nlen 4 min - 8 * >> :m0 & :w0 ns 4 + Tm min {text Neg 4 nlen 4 - 0 max 4 min - 8 * >> :m1 & :w1 ns 8 + Tm min {text Neg 4 nlen 8 - 0 max 4 min - 8 * >> :m2 & :w2 ns 12 + Tm min {text Neg 4 nlen 12 - 0 max 4 min - 8 * >> & :w3 drop drop drop end
# literals: fill each dword with '0' past the literal's end; all bytes must be digits (E_LEX); the three
# 4-digit groups are evaluated in place and scaled by the literal's length
808464432 >Z30
252645135 >M0f
101058054 >Z06
16711935 >Mff
w0 m0 Neg ^ Z30 & | Z30 ^ :va dup 4 >> M0f & 0 = swap Z06 + 4 >> M0f & 0 = & :dk0 va 2561 * 8 >> Mff & 6553601 * 16 >> :ga drop end
w1 m1 Neg ^ Z30 & | Z30 ^ :vb dup 4 >> M0f & 0 = swap Z06 + 4 >> M0f & 0 = & :dk1 vb 2561 * 8 >> Mff & 6553601 * 16 >> :gb drop end
w2 m2 Neg ^ Z30 & | Z30 ^ :vc dup 4 >> M0f & 0 = swap Z06 + 4 >> M0f & 0 = & :dk2 vc 2561 * 8 >> Mff & 6553601 * 16 >> :gc drop end
nlen 9 min :dl @lm1 ga * dl @ls1 >> dl @lm2 gb * dl @ls2 >> + dl @lm3 gc * dl @ls3 >> + lit * :val lit nlen Maxdig > dk0 dk1 & dk2 & 1 ^ | & swap drop $El
El 0 > 2 * halt
isname nlen Maxname > & $En
En 0 > 3 * halt
# the fingerprint: two sums over the four dwords (boot/spec.py, name_hash)
w0 Ha1 * dup Hs1 >> ^ Hb1 * w1 1 + Ha1 * dup Hs1 >> ^ Hb1 * + w2 2 + Ha1 * dup Hs1 >> ^ Hb1 * + w3 3 + Ha1 * dup Hs1 >> ^ Hb1 * + :h1 w0 Ha2 * dup Hs2 >> ^ Hb2 * w1 1 + Ha2 * dup Hs2 >> ^ Hb2 * + w2 2 + Ha2 * dup Hs2 >> ^ Hb2 * + w3 3 + Ha2 * dup Hs2 >> ^ Hb2 * + :h2 drop end
# keywords: one lookup by fingerprint, confirmed by comparing the four dwords
h1 Kwshift >> 255 & @kwidx :ki @kwh0 16 << ki @kwl0 | w0 = ki @kwh1 16 << ki @kwl1 | w1 = & ki @kwh2 16 << ki @kwl2 | w2 = & ki @kwh3 16 << ki @kwl3 | w3 = & ki * isname * :kw 0 = isname & :nm end

# ---------------------------------------------------------------- the constant pool
# One unit per literal, one per byte of a string, in token order: a prefix sum places each token's units.
# String bytes are fetched by the same fill-forward as code bytes (below): each string marks its first
# unit with the distance back to its text, a running max spreads the mark, one gather reads the bytes.
lit str len 2 - * + :un scan un - >pidx
un $U
~U 0 * >pmark
start 1 + pidx - str len 2 > & pidx Neg sel !pmark
pmark scanmax idx + Tm min 0 max [text >pool
val lit pidx Neg sel !pool

# ---------------------------------------------------------------- names: the scatter race
# Every unresolved name token scatters its index into table[key]; the last writer owns the slot.
# A token whose slot owner has its fingerprint is resolved to that owner (its canonical occurrence,
# which is therefore the name's LAST occurrence). Losers race again under the next key.
NT dup 1 >> | dup 2 >> | dup 4 >> | dup 8 >> | dup 16 >> | 2 * 1 + >Mask
Mask 1 + >Tabm
~Tabm 0 * >tab
nm >act
~NT 0 * >rep
act h1 Ru0 * h2 Rv0 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok0 swap rep sel >rep
act ok0 1 ^ & >act
act h1 Ru1 * h2 Rv1 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok1 swap rep sel >rep
act ok1 1 ^ & >act
act h1 Ru2 * h2 Rv2 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok2 swap rep sel >rep
act ok2 1 ^ & >act
act h1 Ru3 * h2 Rv3 * + 8 >> Mask & Neg sel >key
~NT key !tab
key 0 max @tab dup @h1 h1 = over @h2 h2 = & act & :ok3 swap rep sel >rep
act ok3 1 ^ & $Er
Er 0 > 4 * halt
# two different names with one fingerprint: the dwords of a token and of its canonical occurrence differ
rep @w0 w0 != rep @w1 w1 != | rep @w2 w2 != | rep @w3 w3 != | nm & $Ec
Ec 0 > 5 * halt

# ---------------------------------------------------------------- slots by one scan
nm rep idx = & :isrep scan >sid
rep @sid nm * >slot
isrep $S
S 1 + >S1

# ---------------------------------------------------------------- token classes
kw 0 > sgi 0 > & Cerr kw 0 > sgi 0 = & kw 1 - sgi 5 * opc + @clstab sel sel dup @leadof over - first * + :cls4 Cerr = $Et
Et 0 > 6 * halt
# data lines: the class of a line's last token decides
~NL2 0 * >lsk
cls4 last ln1 Neg sel !lsk
ln1 @lsk Cdata = last 1 ^ & :ditem sgi 0 = lit & cls4 Cstr = | 1 ^ & cls4 Cdata = last 1 ^ & cls4 Cstr = | ditem 1 ^ & | $Ed
Ed 0 > 7 * halt
ditem Cnone cls4 sel >clsd
# byte lines: a `bytes` lead switches every token of its line to the byte-lane class
~NL2 0 * >lbt
clsd @isblead first ln1 Neg sel !lbt
ln1 @lbt clsd @byteof clsd - * clsd + >clso
# chunk-local vectors: a ':x' whose last occurrence (its canonical token) is on the tee's own line never
# needs an array. Its occurrences there switch class, and keep just the current chunk in x's slot.
~S1 0 * >tdef
~NT 1 + clso @istee clso @isteec | slot Neg sel !tdef
slot @tdef :td1 1 - 0 max :td @clso @istee td1 0 > & isname & td @rep @ln1 td @ln1 = & ln1 td @ln1 = & :loc clso @localof clso - * clso + >clsl
# ... and a ':x' that does outlive its line but is pushed again on it: that push reads the array while it
# is being written, so it takes a class that keeps the line on one thread
td1 0 > isname & idx td != & ln1 td @ln1 = & loc 1 ^ & clsl @tvof clsl - * clsl + >cls

# ---------------------------------------------------------------- stack depth = register allocation, by one scan
cls @delta 4 - :dlt scan :da dlt - :d0 0 < d0 8 > | da 0 = last != | cls Ncode < :code & $Edp
Edp 0 > 8 * halt
cls Nd * d0 + code * :tid @slen :sl 0 = code & $Es
Es 0 > 9 * halt
# two carry-using ops at one depth on one line would share a carry register: detect by scatter race
cls @carry code * >cg
NL2 32 * >Ct
~Ct 0 * >ctab
cg 0 > ln1 32 * cg 16 * + d0 + Neg sel >ck
~NT ck !ctab
ck 0 max @ctab idx != cg 0 > & $Ecy
Ecy 0 > 10 * halt
# a line may not read the vector it scatters into
~NL2 0 * >lss
last cls @isscat & slot * last ln1 Neg sel !lss
ln1 @lss dup 0 > swap slot = & cls @readsvec & $Ea
Ea 0 > 11 * halt
# every used variable is defined somewhere
~S1 0 * >def
cls @defines dup slot Neg sel !def
slot @def 0 = cls @uses & isname & $Eu
Eu 0 > 12 * halt
# tee rules: a tee-defined name has exactly one definition, and on the tee's own line it may only be
# re-read after a ':' tee
~S1 0 * >ldef
~NT cls @defines slot Neg sel !ldef
td1 0 > cls @defines & slot @ldef idx != & $Et1
td @clso @istee clso @reread & idx td > & 1 ^ td1 0 > isname & idx td != & ln1 td @ln1 = & & $Et2
Et1 Et2 + 0 > 13 * halt
# a name is a byte vector or a dword vector, never both: every typed use scatters its type to the slot
~S1 0 * >vty
cls @vtype dup 0 > isname & slot Neg sel !vty
slot @vty cls @vtype :vt != vt 0 > & isname & $Ety
Ety 0 > 14 * halt

# ---------------------------------------------------------------- data image: slots, then pool
lit S1 Slot * pidx 4 * + slot Slot * sel >disp
S1 Slot * U 4 * + >Ds
Vbase 112 + Stublen + >Vd
S1 16 * >Si
~Si 0 * >simg
~NL2 0 * >lfp
pidx first ln1 Neg sel !lfp
ln1 @lfp :fp 4 * Vd + S1 Slot * + cls Cdata = :isd slot 16 * Neg8 sel !simg
pidx fp - isd slot 16 * 2 + Neg8 sel !simg
~1 Ds + 0 !simg
~1 S1 Slot * + 2 !simg

# ---------------------------------------------------------------- code layout
# Liveness without analysis: the program is a straight line, so a vector is dead after the line holding
# its last occurrence -- and the scatter race already made that occurrence the canonical one (rep = self).
isname opc 1 = & slot 0 > & rep idx = & loc 1 ^ & >dying
# Each token owns up to three pieces of code, and a line is laid out as
#   [every token's prologue] [every token's body] [releases of vectors that die here]
# so loop-invariant work is hoisted with no motion pass: three streams, three prefix sums.
code tid @qlen * :psz scan :sp psz - :spx code sl * :asz scan :sa asz - :sax dying Rell * :bsz scan bsz - :sbx drop drop end
~NL2 0 * >lft
~NT first ln1 Neg sel !lft
~NL2 0 * >llt
~NT last ln1 Neg sel !llt
ln1 @lft :tf @sbx :fb tf @sax + spx + :offp ln1 @llt :tl @sp :lp fb + sax + :offa lp tl @sa + sbx + :offb drop drop end
code tid @qlen * code sl * + dying Rell * + $C

# ---------------------------------------------------------------- code bytes: copy stencils, patch operands
# Every token owns up to three slices of the stencil blob (prologue, body, release). One pass over the
# tokens copies each to its offset; then every operand is one dword stored at a byte position.
sten .stenb
~C 0 * .cb
tid dup @qstart psz offp (stenb )cb dup @sstart code sl * offa )cb dup 0 * Rels + dying Rell * offb )cb end
tid @qadd disp + tid @qpos dup 0 > psz 0 > & swap offp + 1 - Neg sel }cb
tid @padd disp + tid @ppos dup 0 > code & swap offa + 1 - Neg sel }cb
slot Slot * dying offb Relp + 1 - Neg sel }cb

# ---------------------------------------------------------------- ELF, by concatenation
112 Stublen + Ds + C + &tail + >F
~8 8 * dup 0 * F + swap >> 255 & >f8
ehdr out
f8 out
f8 out
stub out
simg out4
pool out4
'cb out
tail out
